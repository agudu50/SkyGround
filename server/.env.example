# ==============================================================================
# SkyGround Backend Server: Environment Variables
# ==============================================================================

PORT=4000
NODE_ENV=development

# 1. Neon Serverless Postgres with PostGIS
# Format: postgres://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
NEON_DATABASE_URL="postgres://skyground_owner:sample_token@ep-hidden-dawn-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Google AI Studio (Gemini 2.5 Flash)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# 3. Khaya AI (Ghana NLP)
KHAYA_API_KEY="your-khaya-nlp-subscription-key"

# 4. OpenWeather API (Atmospheric data)
OPENWEATHER_API_KEY="your-openweather-api-key"

# 5. Agromonitoring Agro API (Soil Moisture & NDVI)
AGROMONITORING_API_KEY="your-agromonitoring-api-key"

