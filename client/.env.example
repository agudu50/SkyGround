# ==============================================================================
# SkyGround: Environment Variables & Integration Config
# ==============================================================================

# 1. Neon Serverless Postgres with PostGIS
# Format: postgres://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
EXPO_PUBLIC_NEON_DATABASE_URL="postgres://skyground_owner:sample_token@ep-hidden-dawn-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Google AI Studio (Gemini 2.5 Flash)
# Used for structured JSON hydrological reasoning and 3-bullet municipal directives
EXPO_PUBLIC_GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# 3. Khaya AI (Ghana NLP) REST API
# Subscription key for /v2/translate (en-tw, en-gaa) and /v2/tts
EXPO_PUBLIC_KHAYA_API_KEY="your-khaya-nlp-subscription-key"

# 4. OpenWeather API (Atmospheric Convective Forecasts)
EXPO_PUBLIC_OPENWEATHER_API_KEY="your-openweather-api-key"

# 5. Agromonitoring Agro API (0-10cm Soil Moisture & NDVI)
EXPO_PUBLIC_AGROMONITORING_API_KEY="your-agromonitoring-api-key"

